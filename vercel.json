{
  "functions": {
    "api/coaching-apply.ts": {
      "maxDuration": 30
    },
    "api/handbook-lead.ts": {
      "maxDuration": 30,
      "memory": 1024
    },
    "api/stripe/create-checkout-session.ts": {
      "maxDuration": 30
    },
    "api/stripe/verify-session.ts": {
      "maxDuration": 30
    },
    "api/stripe/webhook.ts": {
      "maxDuration": 30
    },
    "api/push/daily.ts": {
      "maxDuration": 60
    },
    "api/stripe/claim.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/push/daily",
      "schedule": "0 4 * * *"
    }
  ]
}
